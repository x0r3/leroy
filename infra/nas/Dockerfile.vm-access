FROM alpine:3.24
RUN apk add --no-cache openssh-server && passwd -d root && mkdir -p /run/sshd
ENTRYPOINT ["sh", "-c", "mkdir -p /run/sshd /run/leroy-ssh; cp /config/host_key /run/leroy-ssh/host_key; cp /config/authorized_keys /run/leroy-ssh/authorized_keys; chmod 600 /run/leroy-ssh/*; exec /usr/sbin/sshd -D -e -f /config/sshd_config"]
