+fn private_postdeploy_directory(path: &Path, owner: u32) -> AppResult<()> {
+    match fs::DirBuilder::new().mode(0o700).create(path) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(error.into()),
+    }
+    let directory = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    if directory.metadata()?.uid() != owner {
+        return Err(host_inventory::invalid(
+            "Postdeploy state has an unexpected owner",
+        ));
+    }
+    directory.set_permissions(fs::Permissions::from_mode(0o700))?;
+    Ok(())
+}
+
 fn authorized_connection(uid: u32, pid: i32, server_pid: i32) -> bool {
     uid == 0 || uid == 1000 && pid == server_pid
 }
@@ -327,6 +346,49 @@ pub(crate) fn run_cli() -> Option<AppResult<()>> {
 mod tests {
     use super::*;
     #[test]
+    fn postdeploy_state_is_private_for_fresh_and_existing_directories() {
+        let root =
+            std::env::temp_dir().join(format!("graphato-private-state-{}", uuid::Uuid::new_v4()));
+        fs::create_dir(&root).unwrap();
+        let state = root.join("postdeploy");
+        let uid = unsafe { libc::geteuid() };
+        private_postdeploy_directory(&state, uid).unwrap();
+        assert_eq!(
+            fs::metadata(&state).unwrap().permissions().mode() & 0o777,
+            0o700
+        );
+        fs::set_permissions(&state, fs::Permissions::from_mode(0o755)).unwrap();
+        private_postdeploy_directory(&state, uid).unwrap();
+        assert_eq!(
+            fs::metadata(&state).unwrap().permissions().mode() & 0o777,
+            0o700
+        );
+        assert!(private_postdeploy_directory(&state, uid ^ 1).is_err());
+        fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn postdeploy_state_rejects_symlinks_and_files_without_changing_them() {
+        let root =
+            std::env::temp_dir().join(format!("graphato-private-state-{}", uuid::Uuid::new_v4()));
+        fs::create_dir(&root).unwrap();
+        let target = root.join("target");
+        fs::create_dir(&target).unwrap();
+        fs::set_permissions(&target, fs::Permissions::from_mode(0o755)).unwrap();
+        let link = root.join("postdeploy");
+        std::os::unix::fs::symlink(&target, &link).unwrap();
+        let uid = unsafe { libc::geteuid() };
+        assert!(private_postdeploy_directory(&link, uid).is_err());
+        assert_eq!(
+            fs::metadata(&target).unwrap().permissions().mode() & 0o777,
+            0o755
+        );
+        let file = root.join("file");
+        fs::write(&file, "retained").unwrap();
+        assert!(private_postdeploy_directory(&file, uid).is_err());
+        assert_eq!(fs::read_to_string(&file).unwrap(), "retained");
+        fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
     fn cleanup_admits_only_server_and_health_peers_before_reading() {
         assert!(authorized_connection(1000, 7, 7));
         assert!(authorized_connection(0, 42, 7));
