--- a/apps/desktop/src-tauri/src/providers/model_connections/store.rs
+++ b/apps/desktop/src-tauri/src/providers/model_connections/store.rs
@@ -21,6 +21,14 @@ pub(super) struct Lease {
     id: String,
     exclusive: bool,
 }
+impl Drop for Lease {
+    fn drop(&mut self) {
+        // A concurrent fork can retain this open file description until exec,
+        // despite O_CLOEXEC. Closing our descriptor alone may leave its flock
+        // active; the logical lease must release it before another owner enters.
+        let _ = FileExt::unlock(&self._file);
+    }
+}
