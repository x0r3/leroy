+#[test]
+fn dropping_lease_unlocks_even_while_a_fork_duplicate_remains_open() {
+    let fixture = Fixture::new();
+    for exclusive in [false, true] {
+        let lease = fixture.store.lock(&fixture.id, exclusive).unwrap();
+        // dup and fork share the same open file description and flock. Holding
+        // a duplicate reproduces the pre-exec window without a timing race.
+        let inherited = lease._file.try_clone().unwrap();
+        assert!(fixture.store.lock(&fixture.id, true).is_err());
+        drop(lease);
+        let replacement = fixture.store.lock(&fixture.id, true).unwrap();
+        assert!(fixture.store.lock(&fixture.id, false).is_err());
+        drop(inherited);
+        assert!(fixture.store.lock(&fixture.id, true).is_err());
+        drop(replacement);
+        assert!(fixture.store.lock(&fixture.id, true).is_ok());
+    }
+}
