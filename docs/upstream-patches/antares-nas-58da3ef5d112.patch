diff --git a/apps/game/__tests__/confirmation-dialog-lifecycle.test.tsx b/apps/game/__tests__/confirmation-dialog-lifecycle.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..728fb22d86176c8714ddbe05cac45c4e63a8a6af
--- /dev/null
+++ b/apps/game/__tests__/confirmation-dialog-lifecycle.test.tsx
@@ -0,0 +1,40 @@
+import { fireEvent, render, screen } from '@testing-library/react';
+import { describe, expect, it, vi } from 'vitest';
+
+import { ConfirmationDialog } from '../src/ConfirmationDialog';
+
+describe('confirmation dialog lifecycle', () => {
+  it('keeps an open confirmation stable across fresh parent callbacks and uses the latest handlers', () => {
+    const showModal = vi.fn(function show(this: HTMLDialogElement) {
+      this.setAttribute('open', '');
+    });
+    const close = vi.fn(function hide(this: HTMLDialogElement) {
+      this.removeAttribute('open');
+    });
+    Object.defineProperty(HTMLDialogElement.prototype, 'showModal', { configurable: true, value: showModal });
+    Object.defineProperty(HTMLDialogElement.prototype, 'close', { configurable: true, value: close });
+    const firstClose = vi.fn();
+    const latestClose = vi.fn();
+    const firstAction = vi.fn();
+    const latestAction = vi.fn();
+    const request = { title: 'Allianz auflösen', message: 'Endgültig auflösen?',
+      confirmLabel: 'Dauerhaft auflösen', action: firstAction };
+    const view = render(<ConfirmationDialog request={request} onClose={firstClose} />);
+    const button = screen.getByRole('button', { name: 'Dauerhaft auflösen' });
+    const dialog = screen.getByRole('alertdialog');
+    for (let tick = 0; tick < 5; tick += 1) {
+      view.rerender(<ConfirmationDialog request={{ ...request, action: latestAction }} onClose={() => latestClose()} />);
+    }
+    expect(showModal).toHaveBeenCalledTimes(1);
+    expect(close).not.toHaveBeenCalled();
+    expect(dialog).toHaveAttribute('open');
+    expect(screen.getByRole('button', { name: 'Dauerhaft auflösen' })).toBe(button);
+    fireEvent.click(button);
+    expect(latestClose).toHaveBeenCalledTimes(1);
+    expect(latestAction).toHaveBeenCalledTimes(1);
+    expect(firstClose).not.toHaveBeenCalled();
+    expect(firstAction).not.toHaveBeenCalled();
+    view.unmount();
+    expect(close).toHaveBeenCalledTimes(1);
+  });
+});
