diff --git a/tests/e2e/helpers/capture-clock.ts b/tests/e2e/helpers/capture-clock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4c483f631b00a0c5ebe3815375b80584de66474f
--- /dev/null
+++ b/tests/e2e/helpers/capture-clock.ts
@@ -0,0 +1,15 @@
+import type { Page } from '@playwright/test';
+
+/** Keep JS phase timers stable while assertions and PNG encoding consume wall time. */
+export async function withPausedCaptureClock<T>(page: Page, capture: () => Promise<T>): Promise<T> {
+  const captureTime = new Date();
+  // Fixed wall time makes pauseAt independent of protocol latency on a busy host.
+  await page.clock.setFixedTime(captureTime);
+  try {
+    await page.clock.pauseAt(captureTime);
+    return await capture();
+  } finally {
+    await page.clock.setSystemTime(new Date());
+    await page.clock.resume();
+  }
+}
diff --git a/tests/integration/maintenance-readers.test.ts b/tests/integration/maintenance-readers.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b821d2507a7ae7496f4467a638aaef11f711711c
--- /dev/null
+++ b/tests/integration/maintenance-readers.test.ts
@@ -0,0 +1,58 @@
+import { get } from 'node:http';
+
+import Fastify from 'fastify';
+import { expect, it } from 'vitest';
+
+import { createMaintenancePreHandler } from '../../src/server/game/routes.js';
+import { openTestDatabase } from './helpers/test-database.js';
+
+it('releases a reader when the client disconnects while its gate is being acquired', async () => {
+  const database = openTestDatabase();
+  const acquired = Promise.withResolvers<void>();
+  const resume = Promise.withResolvers<void>();
+  const disconnected = Promise.withResolvers<void>();
+  const completed = Promise.withResolvers<void>();
+  const app = Fastify();
+  let handlerCalls = 0;
+  app.addHook('onRequest', async (_request, reply) => {
+    reply.raw.once('close', () => disconnected.resolve());
+  });
+  const preHandler = createMaintenancePreHandler({
+    ...database,
+    async transaction(operation) {
+      const result = await database.transaction(operation);
+      acquired.resolve();
+      await resume.promise;
+      return result;
+    },
+  });
+  app.addHook('preHandler', async (request, reply) => {
+    await preHandler(request, reply);
+    completed.resolve();
+  });
+  app.get('/', async () => {
+    handlerCalls += 1;
+    return { ok: true };
+  });
+  try {
+    const address = await app.listen({ host: '127.0.0.1', port: 0 });
+    const request = get(address);
+    request.on('error', () => undefined);
+    await acquired.promise;
+    request.destroy();
+    await disconnected.promise;
+    resume.resolve();
+    await completed.promise;
+    await expect.poll(async () => {
+      const result = await database.query<{ count: number }>(
+        'SELECT count(*)::integer AS count FROM game_state_readers',
+      );
+      return result.rows[0]?.count;
+    }).toBe(0);
+    expect(handlerCalls).toBe(0);
+  } finally {
+    resume.resolve();
+    await app.close();
+    await database.close();
+  }
+});
