+// @vitest-environment jsdom
+
+import { fireEvent, render, screen, waitFor, within } from '@testing-library/react';
+import { describe, expect, it, vi } from 'vitest';
+
+import { playerApi } from '../../shared/api';
+import { SocialOverlay } from '../src/SocialOverlay';
+
+vi.mock('../../shared/api', () => ({
+  playerApi: vi.fn(),
+  newCommandId: vi.fn(),
+  errorMessage: String,
+}));
+
+describe('faction reputation accessibility', () => {
+  it('keeps the named list accessible while its request is pending and after loading', async () => {
+    let finishNpc!: (value: unknown) => void;
+    const pendingNpc = new Promise((resolve) => { finishNpc = resolve; });
+    vi.mocked(playerApi).mockImplementation((path) => path === '/api/game/npc'
+      ? pendingNpc as ReturnType<typeof playerApi>
+      : Promise.resolve({ invitations: [], alliance: null, blocks: [] }) as ReturnType<typeof playerApi>);
+
+    render(<SocialOverlay onChanged={async () => {}} />);
+    fireEvent.click(screen.getByRole('tab', { name: 'NPC & Handel' }));
+    const list = screen.getByRole('list', { name: 'Fraktionsrufliste' });
+    expect(within(list).queryAllByRole('listitem')).toHaveLength(0);
+
+    finishNpc({ tradeOffers: [], reputations: [{
+      faction_id: 'faction', name: 'Aurelia', is_federation: false, reputation: 20, hostile: false,
+    }] });
+    await waitFor(() => expect(within(list).getAllByRole('listitem')).toHaveLength(1));
+    expect(list).toHaveAccessibleName('Fraktionsrufliste');
+    expect(within(list).getByRole('listitem')).toHaveTextContent('Aurelia');
+  });
+});
